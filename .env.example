# Clé API Gemini (obligatoire) : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Analyses par jour et par visiteur. Par défaut : 20 en production, illimité en développement.
DAILY_QUOTA_LIMIT=
# Requêtes /api/analyze et /api/upload par minute et par visiteur (défaut : 5)
BURST_LIMIT_PER_MINUTE=
# Sel du hachage des IP (les IP ne sont jamais stockées en clair)
QUOTA_SALT=change-moi
